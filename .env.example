# ============================================================
# Variables de entorno — FamiliaPuess
# Copia este archivo a .env y completa los valores marcados.
# ============================================================

# ---- Base de datos (PostgreSQL) ----
POSTGRES_PASSWORD=                        # Requerido para docker-compose up
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/familia_puess

# ---- API (FastAPI) ----
APP_TIMEZONE=America/Bogota
JWT_SECRET_KEY=                           # Min 32 chars. Generar: python -c "import secrets; print(secrets.token_urlsafe(48))"
DESKTOP_API_KEY=                          # Llave para la app de escritorio. Generar: python -c "import secrets; print(secrets.token_urlsafe(128))"
CORS_ORIGINS='["http://localhost:5173"]'  # Orígenes permitidos (JSON array)

# ---- Web (Vite / React) ----
VITE_API_BASE_URL=http://localhost:8000   # URL base de la API desde el navegador

# ---- Sistema de Escritorio (apps/Desktop) ----
DESKTOP_API_BASE_URL=https://process-api.familiapues.com
DESKTOP_DISPOSITIVO_IDENTIFICADOR=KIOSK-001
DESKTOP_REGISTRO_PUBLICO_URL=https://imputar.familiapues.com/registro
DESKTOP_ROTACION_FALLBACK_SEGUNDOS=30
